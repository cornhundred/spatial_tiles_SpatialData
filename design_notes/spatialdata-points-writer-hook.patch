diff --git a/tests/io/test_readwrite.py b/tests/io/test_readwrite.py
index c018d88..37597fe 100644
--- a/tests/io/test_readwrite.py
+++ b/tests/io/test_readwrite.py
@@ -1368,3 +1368,48 @@ def test_sdata_with_nan_in_obs(tmp_path: Path, convert_strings_to_categoricals:
             assert pd.isna(r1.iloc[1])
         else:
             assert r1.iloc[1] == "nan"
